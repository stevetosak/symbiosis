{
	"name": "symbiosis",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"description": "The pi coding agent works inside the ttt editor: you watch every write as it happens.",
	"keywords": [
		"pi-package",
		"ttt",
		"herdr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stevetosak/symbiosis.git"
	},
	"type": "module",
	"scripts": {
		"test": "bin/run-node --test 'test/**/*.test.ts'",
		"build": "bin/run-node ttt/build.ts",
		"test:lua": "luajit test/lua/run.lua .",
		"e2e": "test/e2e/run.sh",
		"demo": "bin/run-node demo/run.ts",
		"install:local": "bin/run-node install.ts"
	},
	"engines": {
		"node": ">=24"
	},
	"pi": {
		"extensions": [
			"./pi/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	}
}
