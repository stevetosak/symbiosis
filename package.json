{
	"name": "symbiosis",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"description": "The pi coding agent works inside the ttt editor: you watch every write as it happens.",
	"keywords": [
		"pi-package",
		"ttt",
		"herdr"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stevetosak/symbiosis.git"
	},
	"type": "module",
	"scripts": {
		"test": "bin/run-node --test 'test/**/*.test.ts'",
		"build": "bin/run-node ttt/build.ts",
		"test:lua": "bin/run-node ttt/build.ts && luajit test/lua/run.lua .",
		"e2e": "test/e2e/run.sh",
		"demo": "bin/run-node demo/run.ts",
		"install:local": "bin/run-node install.ts"
	},
	"engines": {
		"node": ">=24"
	},
	"pi": {
		"extensions": [
			"./pi/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"dependencies": {
		"diff": "8.0.4",
		"@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
		"@tree-sitter-grammars/tree-sitter-lua": "0.4.1",
		"tree-sitter-c-sharp": "0.23.5",
		"tree-sitter-go": "0.25.0",
		"tree-sitter-python": "0.25.0",
		"tree-sitter-typescript": "0.23.2",
		"web-tree-sitter": "0.27.1"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0"
	}
}
