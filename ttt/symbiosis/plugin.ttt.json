{
  "name": "symbiosis",
  "displayName": "symbiosis",
  "description": "Integrate the PI agent into ttt, for a seamless IDE first workflow. Call the agent inline with a comment that ends with: helpi!, either to ask a question or to write code",
  "version": "0.17.0",
  "author": "stevetosak",
  "entry": "plugin.lua",
  "api": 1,
  "permissions": {
    "editor.read": true,
    "editor.write": true,
    "fs.read": true,
    "fs.write": true,
    "commands": true,
    "keybindings": true,
    "events.file": true,
    "events.editor": true,
    "panel.drawer": true,
    "system.exec": [
      "herdr",
      "tmux",
      "symbiosis"
    ],
    "panel.sidebar": true,
    "editor.bookmarks": true,
    "panel.bottom": true
  }
}
