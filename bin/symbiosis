#!/bin/sh
# symbiosis: runs launcher/main.ts with bin/node-ts. ~/.local/bin/symbiosis is
# a link to this file, so the links are followed to find the repository.
set -eu

self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case "$link" in
		/*) self=$link ;;
		*) self=${self%/*}/$link ;;
	esac
done
repo=$(cd "${self%/*}/.." && pwd)
exec "$repo/bin/node-ts" "$repo/launcher/main.ts" "$@"
